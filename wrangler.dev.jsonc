{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salesshop-dev",
  "compatibility_date": "2026-10-23",
  "main": "./worker/dev-auth-gateway.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
