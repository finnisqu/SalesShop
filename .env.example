# SalesShop Supabase
# Use the project URL plus the publishable key from Supabase project settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy anon keys are also accepted by the client if needed:
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional Gmail v0.1 browser-only OAuth integration
# Create a Google OAuth Web client (not a client secret) with SalesShop's authorized
# JavaScript origin. Enable Gmail API and authorize gmail.readonly.
# Gmail read-only is a restricted scope; Google consent/verification applies.
# VITE_GOOGLE_GMAIL_CLIENT_ID=your-public-client-id.apps.googleusercontent.com
